{
	"name": "brandonwie.dev",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"dev": "vite dev",
		"build": "vite build && npx pagefind --site build",
		"preview": "vite preview",
		"search:preview": "npm run build && vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"sync": "deno run --allow-read --allow-write --allow-env scripts/sync-from-3b.ts",
		"sync:check": "deno run --allow-read --allow-env scripts/sync-from-3b.ts --check",
		"sync:diff": "deno run --allow-read --allow-write --allow-env --allow-run scripts/sync-from-3b.ts --diff",
		"sync:reconcile": "deno run --allow-read --allow-write --allow-env scripts/sync-from-3b.ts --reconcile",
		"hash": "deno run --allow-read --allow-env scripts/compute-content-hash.ts",
		"translation:status": "npx tsx scripts/translation-status.ts",
		"translation:create": "npx tsx scripts/translation-create.ts",
		"og:generate": "tsx scripts/generate-og-images.ts",
		"og:generate:force": "tsx scripts/generate-og-images.ts --force",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"validate:dates": "npx tsx scripts/validate-dates.ts",
		"validate:dates:fix": "npx tsx scripts/validate-dates.ts --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.16",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.12.0",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"github-slugger": "^2.0.0",
		"globals": "^17.4.0",
		"gray-matter": "^4.0.3",
		"husky": "^9.1.7",
		"mdast-util-to-string": "^4.0.0",
		"mdsvex": "^0.12.3",
		"pagefind": "^1.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.0",
		"satori": "^0.26.0",
		"shiki": "^4.0.2",
		"svelte": "^5.19.0",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^4.2.1",
		"tsx": "^4.21.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.57.0",
		"unist-util-visit": "^5.1.0",
		"vfile": "^6.0.3",
		"vite": "^8.0.0"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.9.1",
		"@tailwindcss/vite": "^4.2.1",
		"clsx": "^2.1.1",
		"fuse.js": "^7.0.0",
		"mermaid": "^11.12.2"
	}
}
