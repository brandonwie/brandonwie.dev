{
	"name": "brandonwie.dev",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"prepare": "husky",
		"dev": "vite dev",
		"build": "pnpm build:svelte && pnpm build:next",
		"build:svelte": "vite build && pagefind --site build",
		"build:next": "pnpm --filter brandonwie-dev-next build && pagefind --site next/build",
		"preview": "vite preview",
		"cf:preview": "pnpm build && wrangler pages dev build",
		"search:preview": "corepack pnpm run build && vite preview",
		"check": "pnpm check:svelte && pnpm check:next && pnpm check:scripts",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:next": "pnpm --filter brandonwie-dev-next check",
		"check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"migration:verify": "tsx scripts/migration-verify.ts",
		"migration:capture": "tsx scripts/migration-verify.ts capture build verification/baseline/svelte-e23e808.json",
		"migration:controls": "tsx scripts/migration-verify-controls.ts build verification/baseline/svelte-e23e808.json",
		"migration:verify:next": "tsx scripts/migration-verify.ts compare verification/baseline/svelte-e23e808.json next/build",
		"migration:verify:svelte": "tsx scripts/migration-verify.ts compare verification/baseline/svelte-e23e808.json build --ledger verification/empty-ledger.json",
		"migration:c13": "tsx scripts/assert-c13-shell.ts",
		"migration:c13:controls": "tsx scripts/assert-c13-shell-controls.ts",
		"migration:c11": "tsx --tsconfig next/tsconfig.json scripts/assert-c11-library-ports.ts",
		"migration:c11:controls": "tsx --tsconfig next/tsconfig.json scripts/assert-c11-library-ports-controls.ts",
		"migration:spike2": "tsx --tsconfig next/tsconfig.json scripts/assert-slice2-motion.ts",
		"migration:spike2:controls": "tsx --tsconfig next/tsconfig.json scripts/assert-slice2-motion-controls.ts",
		"migration:gsap-palette": "tsx --tsconfig next/tsconfig.json scripts/assert-slice2-gsap-palette.ts",
		"migration:gsap-palette:controls": "tsx --tsconfig next/tsconfig.json scripts/assert-slice2-gsap-palette-controls.ts",
		"migration:c3": "tsx scripts/assert-c3-runtimes.ts",
		"migration:c3:controls": "tsx scripts/assert-c3-runtimes-controls.ts",
		"migration:c3:hermetic": "tsx scripts/assert-c3-runtimes.ts --lane=hermetic",
		"migration:c3:hermetic:controls": "tsx scripts/assert-c3-runtimes-controls.ts --lane=hermetic",
		"migration:article": "tsx scripts/assert-article-parity.ts",
		"migration:article:controls": "tsx scripts/assert-article-parity-controls.ts",
		"migration:publishing": "tsx scripts/assert-publishing-surfaces.ts",
		"migration:publishing:controls": "tsx scripts/assert-publishing-surfaces-controls.ts",
		"migration:feed": "tsx scripts/assert-feed-redirects.ts",
		"migration:feed:controls": "tsx scripts/assert-feed-redirects-controls.ts",
		"migration:projection": "tsx scripts/assert-baseline-projection.ts",
		"migration:projection:controls": "tsx scripts/assert-baseline-projection-controls.ts",
		"migration:typography": "tsx --tsconfig next/tsconfig.json next/scripts/assert-corpus-typography.ts",
		"migration:ast": "tsx --tsconfig next/tsconfig.json next/scripts/assert-mdsvex-ast.ts",
		"migration:ast:controls": "tsx --tsconfig next/tsconfig.json next/scripts/assert-mdsvex-ast-controls.ts",
		"migration:typography:oracle": "tsx --tsconfig next/tsconfig.json next/scripts/assert-typography-oracle.ts",
		"migration:typography:oracle:controls": "tsx --tsconfig next/tsconfig.json next/scripts/assert-typography-oracle-controls.ts",
		"migration:typography:controls": "tsx --tsconfig next/tsconfig.json next/scripts/assert-corpus-typography-controls.ts",
		"migration:corpus": "tsx --tsconfig next/tsconfig.json next/scripts/compile-corpus.ts",
		"migration:posts:controls": "tsx --tsconfig next/tsconfig.json next/scripts/assert-posts-controls.ts",
		"migration:serve": "node scripts/serve-build.mjs build 4173",
		"migration:route": "tsx scripts/migration-route.ts",
		"migration:route:controls": "tsx scripts/migration-route-controls.ts",
		"migration:all": "tsx scripts/migration-route.ts --all --run --tier all --exclude migration:controls,migration:c3,migration:c3:controls",
		"migration:parity:progress": "tsx scripts/assert-parity-progress.ts",
		"migration:parity:progress:controls": "tsx scripts/assert-parity-progress-controls.ts",
		"sync": "deno run --allow-read --allow-write --allow-env scripts/sync-from-3b.ts",
		"sync:check": "deno run --allow-read --allow-env scripts/sync-from-3b.ts --check",
		"sync:diff": "deno run --allow-read --allow-write --allow-env --allow-run scripts/sync-from-3b.ts --diff",
		"sync:reconcile": "deno run --allow-read --allow-write --allow-env scripts/sync-from-3b.ts --reconcile",
		"sync:rehash": "deno run --allow-read --allow-write --allow-env scripts/sync-from-3b.ts --rehash",
		"snapshot:social": "deno run --allow-read --allow-write --allow-env scripts/snapshot-social.ts",
		"snapshot:social:check": "deno run --allow-read --allow-env scripts/snapshot-social.ts --check",
		"study:check": "deno run --allow-read --allow-env scripts/validate-study-sources.ts",
		"hash": "deno run --allow-read --allow-env scripts/compute-content-hash.ts",
		"translation:status": "tsx scripts/translation-status.ts",
		"translation:create": "tsx scripts/translation-create.ts",
		"og:generate": "tsx scripts/generate-og-images.ts",
		"og:generate:force": "tsx scripts/generate-og-images.ts --force",
		"media:gen": "tsx scripts/media-gen-cover.ts",
		"media:gen:check": "tsx scripts/media-gen-cover.ts --check",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"audit:posts": "tsx scripts/audit-posts.ts",
		"validate:dates": "tsx scripts/validate-dates.ts",
		"validate:dates:fix": "tsx scripts/validate-dates.ts --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.68.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/d3-shape": "^3.1.8",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.13.2",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"github-slugger": "^2.0.0",
		"globals": "^17.7.0",
		"gray-matter": "^4.0.3",
		"gsap": "^3.15.0",
		"husky": "^9.1.7",
		"mdast-util-to-string": "^4.0.0",
		"mdsvex": "^0.12.7",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.1",
		"prettier-plugin-svelte": "^4.1.1",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"satori": "^0.26.0",
		"shiki": "^4.3.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"tailwindcss": "4.3.1",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"unist-util-visit": "^5.1.0",
		"vfile": "^6.0.3",
		"vite": "^8.1.0",
		"wrangler": "4.105.0"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.0.0",
		"@inlang/paraglide-js": "2.20.2",
		"@tailwindcss/vite": "4.3.1",
		"@xyflow/svelte": "^1.6.1",
		"clsx": "^2.1.1",
		"d3-shape": "^3.2.0",
		"fuse.js": "^7.4.2",
		"mermaid": "^11.16.0"
	}
}
