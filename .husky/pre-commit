#!/bin/sh

echo "Running pre-commit checks..."
echo ""

echo "1/3 Linting..."
corepack pnpm run lint || exit 1

echo ""
echo "2/3 Format check (staged files)..."
# Staged files only: a whole-tree `prettier --check .` fails on other tools'
# untracked files in a shared checkout. pre-push still checks the whole tree.
git diff --cached --name-only --diff-filter=ACMR -z |
	xargs -0 -r ./node_modules/.bin/prettier --check --ignore-unknown || exit 1

echo ""
echo "3/3 Frontmatter date validation..."
corepack pnpm run validate:dates || exit 1

echo ""
echo "All pre-commit checks passed!"
