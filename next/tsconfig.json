{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"verbatimModuleSyntax": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		// `next dev` adds the two `build/` entries below (distDir is `build`) and
		// rewrites this file whenever they are missing, which trips the C3 mutation
		// guard. They are committed so the file stays byte-stable; `exclude: ["build"]`
		// still keeps the export output out of type-checking.
		"build/types/**/*.ts",
		"build/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", "build"]
}
