# Dependencies
node_modules/

# Build outputs
.svelte-kit/
build/
dist/

# `next dev` writes these when it detects an AI agent environment
# (next/dist/server/lib/generate-agent-files.js). Project instructions come from
# 3B, so the generated pair stays local and untracked. The same command adds
# `build/types/**/*.ts` and `build/dev/types/**/*.ts` to next/tsconfig.json
# (distDir is `build`) and rewrites that file when they are missing, so they are
# committed there; `exclude: ["build"]` still keeps the export out of
# type-checking. next/tsconfig.json stays strict JSON: three harnesses read it
# with JSON.parse.
next/AGENTS.md
next/CLAUDE.md

# Deno
.deno/

# Environment
.env
.env.*
!.env.example

# Cloudflare Pages local dev secrets (`wrangler pages dev`)
.dev.vars

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Cache
.cache/
.turbo/

# Lock files — this project uses pnpm as its package manager
yarn.lock
package-lock.json
.playwright-mcp/

# Claude Code
.claude/

# Serena MCP local tool state (cache + memories + project.local.yml)
.serena/

# graphify output (per-repo knowledge graph — rebuild via /graphify)
graphify-out/

# graphify local Git hooks installed by `graphify hook install`
.husky/post-checkout
.husky/post-commit

# context-mode plugin local sandbox + index (per-repo, rebuild on demand)
.context-mode/

# Temporary files
tmp/

# Git worktrees (canonical 3B path, ADR-035 — never committed)
.worktrees/

# Cross-agent lock symlink mounted into worktrees (3B multi-session locks)
.agents/

# Next.js migration candidate (temporary two-app workspace)
next/.next
next/next-env.d.ts
next/tsconfig.tsbuildinfo
tsconfig.scripts.tsbuildinfo
