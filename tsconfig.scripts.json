{
	// WHY THIS PROJECT EXISTS. Neither existing project typechecks `scripts/`:
	// the root tsconfig includes src/test/tests only, and next/tsconfig is rooted
	// at next/. So the migration harness -- including C1, the row that asserts the
	// ported modules typecheck -- was itself unchecked, and a real type error sat
	// in it: the Slice 2 seam was declared `typeof FLIP_OPTIONS` (an `as const`,
	// so `absolute` is the literal true) while its own control substitutes
	// `absolute: false`. CodeRabbit found it by reading; `pnpm check` could not.
	//
	// SCOPE IS DELIBERATELY THE SLICE 2 PAIR, not all of scripts/. Measured basis:
	// this exact config with `include` widened to scripts/**/*.ts and nothing else
	// changed, `npx tsc --noEmit -p` reports 111 errors across 7 files -- almost
	// all Deno globals, plus one unrelated cast in the C11 harness. The seven are
	// tracked by the "scripts/ typecheck debt" row in the nextjs-migration task's
	// todos.md, which names them and carries the completion condition. An earlier
	// version of this comment cited plan.md "Raised, not scheduled" as their home;
	// that section does not exist and never did. Widening the include is how the
	// rest gets adopted, one suite at a time, each with its own fixes. Re-measure
	// before quoting the number; it moves as suites are fixed.
	"extends": "./next/tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": ".",
		// The harness runs under tsx in Node: it reads files, spawns processes and
		// exits with a code. next/tsconfig restricts `types`, which hides all of it.
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"paths": { "@/*": ["./next/src/*"] }
	},
	"include": [
		"scripts/assert-slice2-gsap-palette.ts",
		"scripts/assert-slice2-gsap-palette-controls.ts",
		"scripts/assert-c5-glob-sites.ts",
		"scripts/assert-c5-glob-sites-controls.ts"
	]
}
